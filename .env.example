# ===== media-studio 环境变量模板 =====
# 复制为 .env.local 并填入真实值（.env* 已被 .gitignore 忽略，不会提交）
# 维护规则：lib/config.ts 里每新增一个 process.env.X，必须同步补进本文件。

# 数据库：你的 Supabase 项目，专用 ms_app 角色经 transaction pooler 直连（服务端专用）
# 格式：postgresql://ms_app.<projectRef>:<密码>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://ms_app.xxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# 全站密码门禁：留空（或整行删掉）= 公开模式，全站免登录任何人可访问；
# 填了值就启用门禁，未登录页面跳 /login、裸调 API 返 401。
# 注意公开模式下配置接口不回显已存的 API key（只能填新值），避免密钥被访客读走。
ACCESS_PASSWORD=给用户设个好记的密码（留空=公开站）
AUTH_SECRET=随机 32 字节 hex（openssl rand -hex 32）

# 只读模式：READ_ONLY=1 时全站禁写——所有非 GET 的 API 一律 403、每日采集 cron 跳过、
# 设置页整页关闭、顶栏挂只读提示条。给「公开演示站」用的；自部署想正常用就别配这一项。
READ_ONLY=

# 每日采集 cron 鉴权（vercel.json 的定时任务带 Bearer CRON_SECRET 调 /api/cron/daily）
CRON_SECRET=随机 hex（openssl rand -hex 24）

# 站点对外地址：摘要/告警邮件里的「打开收件箱/设置页」链接用它拼 URL（不填默认 http://localhost:3000）
SITE_URL=https://your-domain.example.com

# 采集/回溯抓取时自报的 User-Agent（可选，默认 media-studio-sync/1.0；约定绝不伪装浏览器）
SYNC_UA=media-studio-sync/1.0 (+mailto:you@example.com)

# 文案生成引擎提供方：deepseek（默认）/ qwen / kimi / relay，可选，有内置默认值/DB 配置优先
LLM_PROVIDER=deepseek

# 文案生成引擎（DeepSeek）
DEEPSEEK_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# 文案生成引擎（通义千问，阿里云百炼 DashScope）：可选，有内置默认值/DB 配置优先
QWEN_API_KEY=sk-xxxx
QWEN_MODEL=qwen3.7-max

# 文案生成引擎（Kimi，Moonshot 开放平台）：可选，有内置默认值/DB 配置优先
KIMI_API_KEY=sk-xxxx
KIMI_MODEL=kimi-k2.5

# 文案生成引擎（聚合中转站，任意 OpenAI 兼容端点）：可选，有内置默认值/DB 配置优先
# RELAY_BASE_URL 不填时默认 https://yunwu.ai/v1——仅为「开箱能跑」的示例（与本项目无任何
# 利益关系），可换成自建 OneAPI / New API、OpenRouter 或任何 OpenAI 兼容端点
RELAY_API_KEY=sk-xxxx
RELAY_MODEL=deepseek-v4-pro
RELAY_BASE_URL=https://yunwu.ai/v1

# 封面图生成引擎（任意 OpenAI 兼容生图端点，调 GPT Image 模型）
# 默认示例 yunwu.ai 同样只是可替换占位，与本项目无利益关系
IMAGE_API_BASE=https://yunwu.ai/v1
IMAGE_API_KEY=sk-xxxx
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium

# 邮件通知（Resend）：采集失败告警 + 每日摘要邮件（摘要开关在设置页）
# 也可不填 env，直接在网页设置页填 Resend Key（配置中心优先于 env）
RESEND_API_KEY=re_xxxx
# Resend 发件人（须是已在 Resend 验证的域名地址；不填默认 onboarding@resend.dev 测试发件人）
NOTIFY_FROM=Media Studio <notify@your-domain.example.com>
# 通知收件人（摘要/告警邮件都发到这里）
NOTIFY_TO=you@example.com

# 采集保留天数：可选，有内置默认值/DB 配置优先（DB 即设置页「未处理素材保留天数」）
RSS_RETENTION_DAYS=7

# 洗稿链接回溯的兜底抓取（可选）：x.com 等需要 JS 渲染的页面裸 fetch 拿不到正文，
# 配了 Tavily Extract 才能兜底（tavily.com 免费额度约 1000 次/月），不配则跳过兜底
TAVILY_API_KEY=tvly-xxxx

# 图片存储（Vercel Blob）：AI 生成配图、以及正文里粘贴/拖拽进来的图片都传 Blob 换公网直链
# （公众号只抓外链 <img> 转存，base64 粘不过去）。在 Vercel 上给项目挂 Blob store 后平台
# 会自动注入，本地开发才需要手填；不配则这两条链路不可用，其余功能不受影响
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# 说明：以下配置无 env、只在网页设置页管理（存 ms_sync_state 的 app_config 键）——
#   dailySummary  每日采集摘要邮件开关
#   rssFeeds      RSS 订阅源列表（url + 板块 + 备注）

# 文章配图搜图（免费图库，公众号稿件页「AI 配图」用；配一个即可，也可在设置页填）
PEXELS_API_KEY=xxxx
PIXABAY_API_KEY=xxxx
